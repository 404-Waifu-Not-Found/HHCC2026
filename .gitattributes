# Normalize every text file to LF in the repository and in every working tree.
# Windows checkouts with core.autocrlf=true otherwise produce CRLF files that
# fail Prettier (endOfLine: lf) and source-reading tests.
* text=auto eol=lf

# Keep binary assets untouched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.apk binary
*.ipa binary
*.jar binary
