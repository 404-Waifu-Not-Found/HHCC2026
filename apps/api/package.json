{
  "name": "@clipquest/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "cf:types": "wrangler types worker-configuration.d.ts",
    "typecheck": "npm run cf:types && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude 'scripts/**/*.test.mjs' && node --test scripts/*.test.mjs",
    "dev": "wrangler dev --local",
    "deploy:dry": "wrangler deploy --dry-run",
    "deploy": "node scripts/release-production.mjs",
    "probe:production": "node scripts/probe-worker-assets.mjs --origin https://clipquest.ccwu.cc --offsets 0,120,300,600 --require-affinity true",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@better-auth/expo": "1.6.25",
    "@clipquest/contracts": "0.1.0",
    "better-auth": "1.6.25",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.1",
    "youtubei.js": "17.2.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260730.1",
    "@types/node": "^25.0.3",
    "vitest": "3.2.7",
    "wrangler": "4.115.0"
  }
}
