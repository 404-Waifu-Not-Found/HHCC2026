{
  "name": "@clipquest/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "cf:types": "wrangler types worker-configuration.d.ts",
    "typecheck": "npm run cf:types && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "wrangler dev --local",
    "deploy:dry": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@better-auth/expo": "1.6.25",
    "@clipquest/contracts": "0.1.0",
    "better-auth": "1.6.25",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.32",
    "youtubei.js": "17.2.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.18",
    "@cloudflare/workers-types": "5.20260730.1",
    "@types/node": "^25.0.3",
    "vitest": "3.2.4",
    "wrangler": "4.115.0"
  }
}
