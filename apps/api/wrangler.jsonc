{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clipquest",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": true,
  "routes": [
    {
      "pattern": "clipquest.ccwu.cc",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "../app/dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/health",
      "/",
      "/_sitemap*",
      "/admin",
      "/admin/*",
      "/create/*",
      "/forgot-password*",
      "/generation/*",
      "/library*",
      "/quiz/*",
      "/reset-password*",
      "/settings*",
      "/sign-in*",
      "/sign-up*",
      "/verify-email*",
      "/welcome*",
    ],
    "html_handling": "none",
    "not_found_handling": "404-page",
  },
  "version_metadata": {
    "binding": "WORKER_VERSION",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clipquest",
      "database_id": "bd20a127-8557-4ab0-8f98-531cbbd11236",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "d2dd1683876f44eb99b66443aefba4fd",
    },
  ],
  "r2_buckets": [
    {
      "binding": "PRIVATE_BUCKET",
      "bucket_name": "clipquest-private",
    },
  ],
  "triggers": {
    "crons": ["0 * * * *"],
  },
  "vars": {
    "APP_ORIGIN": "https://clipquest.ccwu.cc",
    "BETTER_AUTH_URL": "https://clipquest.ccwu.cc",
    "DEEPSEEK_MODEL": "deepseek-v4-flash",
    "ENABLE_YOUTUBE_DEMO_HISTORY": "false",
    "MODEL_MANIFEST_KEY": "models/whisper-tiny/manifest.json",
    "QUIZ_V5_2_CANARY_USER_IDS": "",
    "QUIZ_V5_2_ROLLOUT": "disabled",
    "QUIZ_V5_3_CANARY_USER_IDS": "",
    "QUIZ_V5_3_ROLLOUT": "disabled",
    "QUIZ_V5_4_CANARY_USER_IDS": "",
    "QUIZ_V5_4_ROLLOUT": "enabled",
    "QUIZ_V5_9_CANARY_USER_IDS": "",
    "QUIZ_V5_9_ROLLOUT": "disabled",
    "RESEND_FROM": "ClipQuest <hello@clipquest.ccwu.cc>",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
