{
  "name": "@clipquest/app",
  "version": "0.2.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "brand:transparent": "node scripts/remove-asset-backgrounds.mjs",
    "brand:assets": "npm run brand:transparent && node scripts/generate-brand-assets.mjs",
    "motion:docs": "node scripts/generate-motion-doc.mjs && prettier --write ../../docs/MOTION-SYSTEM.md",
    "dev": "expo start",
    "prepare:web": "node scripts/prepare-web-runtime.mjs",
    "web": "npm run prepare:web && expo start --web",
    "web:e2e": "npm run prepare:web && expo start --web --localhost --port 8081",
    "build": "npm run prepare:web && expo export --platform web --clear && node scripts/finalize-web-output.mjs && npm run verify:web-assets",
    "verify:web-assets": "node scripts/verify-web-assets.mjs dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude 'scripts/**/*.test.mjs' && node --test scripts/verify-web-assets.test.mjs",
    "native:prebuild": "expo prebuild",
    "android:internal": "eas build --platform android --profile internal",
    "ios:development": "eas build --platform ios --profile development"
  },
  "dependencies": {
    "@better-auth/expo": "1.6.25",
    "@clipquest/contracts": "0.1.0",
    "@clipquest/local-audio-decoder": "0.1.0",
    "@clipquest/local-quiz-engine": "0.1.0",
    "@expo-google-fonts/dm-sans": "^0.4.1",
    "@expo-google-fonts/fredoka": "0.4.1",
    "@huggingface/transformers": "4.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "better-auth": "1.6.25",
    "buffer": "^6.0.3",
    "expo": "~57.0.14",
    "expo-application": "~57.0.1",
    "expo-build-properties": "~57.0.12",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.8",
    "expo-crypto": "~57.0.1",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-image-manipulator": "^57.0.10",
    "expo-image-picker": "^57.0.11",
    "expo-linking": "~57.0.6",
    "expo-localization": "~57.0.1",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.12",
    "expo-router": "~57.0.14",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "^57.0.13",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "katex": "^0.18.4",
    "mp4box": "^2.3.0",
    "pdf-lib": "^1.17.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "whisper.rn": "0.7.2",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "babel-preset-expo": "~57.0.1",
    "react-refresh": "^0.14.2",
    "sharp": "^0.35.3",
    "vitest": "3.2.7"
  },
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "whisper.rn",
          "@clipquest/local-audio-decoder"
        ]
      }
    }
  }
}
