{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "allowJs": true,
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["expo/types", "react", "react-native", "node"]
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
