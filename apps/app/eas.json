{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "internal": {
      "distribution": "internal",
      "developmentClient": false,
      "credentialsSource": "remote",
      "env": {
        "EXPO_PUBLIC_API_ORIGIN": "https://clipquest.ccwu.cc"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true
    }
  }
}
